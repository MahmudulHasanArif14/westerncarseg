# Public site origin (used for canonical URLs, sitemap, schema). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://westerncars.co.uk

# --- Contact form delivery (Resend: https://resend.com) -------------------
# The contact form POSTs to /api/contact. Without these it returns a friendly
# "please call us" error instead of silently dropping messages.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@westerncars.co.uk
# Must be a sender verified in Resend, e.g. "Western Cars Website <website@westerncars.co.uk>"
CONTACT_FROM_EMAIL=

# --- Analytics (same IDs the WordPress site used) -------------------------
NEXT_PUBLIC_GTM_ID=GTM-TG87NWM
NEXT_PUBLIC_GA_ID=G-9TV8JQCRVJ
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-998265440

# --- WhatsApp chat button (optional) --------------------------------------
# International format, digits only, e.g. 441293850400. Leave empty to hide the button.
# The WordPress plugin was configured with "+1293850400", which is not a valid
# international number — confirm the correct number before enabling.
NEXT_PUBLIC_WHATSAPP_NUMBER=
